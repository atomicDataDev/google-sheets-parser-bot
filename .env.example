# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_0123456

# Telegram Group/Channel Chat ID where notifications will be sent (e.g. -1001234567890)
GROUP_CHAT_ID=-1001234567890

# Optional: Topic / Forum Thread ID in Telegram Supergroups (leave empty if not using topics)
MESSAGE_THREAD_ID=

# Google Spreadsheet ID (found in URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account Credentials as a single-line JSON string
# Make sure to share your Google Spreadsheet with the service account email (Viewer permission)
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"bot-service@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/bot-service%40your-project.iam.gserviceaccount.com"}

# Optional: Comma-separated list of sheet names to monitor (used if content-level Excel parsing is enabled)
TARGET_SHEETS=Sheet1,Sheet2
